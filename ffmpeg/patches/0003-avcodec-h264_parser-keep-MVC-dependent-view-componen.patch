From b8ef0aaceead3d4452dd62cbc620071ef2ae6953 Mon Sep 17 00:00:00 2001
From: aquarat <blue@aquarat.co.uk>
Date: Mon, 14 Sep 2026 22:36:21 +0100
Subject: [PATCH 3/4] avcodec/h264_parser: keep MVC dependent view components
 in their access unit

The dependent view component follows the base view slices within the access
unit and brings its own PPS and SEI NAL units, which the parser took as the
start of the next access unit. Packets then held the dependent view of one
access unit with the base view of the next; an IDR in the base view cleared
the reference state before the preceding dependent view picture was finished,
which put its stale frame_num back and caused frame_num gap concealment (grey
frames) in the dependent view.

Once subset SPS, coded slice extension or Blu-ray type 24 delimiter NAL units
have been seen, only an AUD, an SPS or a new base view picture ends an access
unit.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_012sK2py5V81UwVc4ofRaMXC
---
 libavcodec/h264_parser.c | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/libavcodec/h264_parser.c b/libavcodec/h264_parser.c
index 1b9cf9fe36..3cf8cce61a 100644
--- a/libavcodec/h264_parser.c
+++ b/libavcodec/h264_parser.c
@@ -67,6 +67,7 @@ typedef struct H264ParseContext {
     int parse_last_mb;
     int64_t reference_dts;
     int last_frame_num, last_picture_structure;
+    int mvc;    ///< dependent view NAL units seen, see h264_find_frame_end()
 } H264ParseContext;
 
 static int find_start_code(const uint8_t *buf, int buf_size,
@@ -123,8 +124,16 @@ static int h264_find_frame_end(H264ParseContext *p, const uint8_t *buf,
                 state >>= 1;           // 2->1, 1->0, 0->0
         } else if (state <= 5) {
             int nalu_type = buf[i] & 0x1F;
-            if (nalu_type == H264_NAL_SEI || nalu_type == H264_NAL_SPS ||
-                nalu_type == H264_NAL_PPS || nalu_type == H264_NAL_AUD) {
+            /* In an MVC stream the dependent view components follow the base view
+             * slices within the same access unit, and bring their own PPS and SEI
+             * NAL units along (plus a subset SPS, and on Blu-ray/AVCHD a type 24
+             * delimiter). Once such NAL units have been seen, only an AUD, an SPS
+             * or a new base view picture ends the access unit. */
+            if (nalu_type == H264_NAL_SUB_SPS || nalu_type == H264_NAL_EXTEN_SLICE ||
+                nalu_type == H264_NAL_UNSPECIFIED24)
+                p->mvc = 1;
+            if (nalu_type == H264_NAL_SPS || nalu_type == H264_NAL_AUD ||
+                (!p->mvc && (nalu_type == H264_NAL_SEI || nalu_type == H264_NAL_PPS))) {
                 if (pc->frame_start_found) {
                     i++;
                     goto found;
