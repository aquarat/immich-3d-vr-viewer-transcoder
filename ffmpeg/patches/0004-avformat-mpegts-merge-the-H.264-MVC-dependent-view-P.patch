+/*
+ * H.264 MVC (Blu-ray 3D, AVCHD 3D) carries the dependent view on its own PID, with
+ * stream type 0x20, while a decoder needs both views of an access unit in one
+ * packet: the base view component followed by the dependent view component. Both
+ * PIDs are assembled into whole PES packets, matched up by timestamp, and their
+ * access units interleaved into a single packet of the base view stream. A PES
+ * packet of a field coded stream carries two access units per view, delimited by
+ * an AUD in the base view and a type 24 delimiter in the dependent view (which is
+ * dropped, having no meaning outside the transport stream).
+ */
+#define MVC_MAX_QUEUED 16
+#define MVC_MAX_UNITS  8
+
+static void mvc_flush(MpegTSContext *ts)
+{
+    for (int i = 0; i < 2; i++) {
+        ff_packet_list_free(&ts->mvc_queue[i]);
+        ts->mvc_queued[i] = 0;
+        if (ts->mvc_acc[i])
+            av_packet_unref(ts->mvc_acc[i]);
+    }
+}
+
+static void mvc_pair_program(MpegTSContext *ts, struct Program *prg)
+{
+    PESContext *base = NULL, *dep = NULL;
+
+    for (int i = 0; i < prg->nb_pids; i++) {
+        MpegTSFilter *f = ts->pids[prg->pids[i]];
+        PESContext *pes;
+        if (!f || f->type != MPEGTS_PES)
+            continue;
+        pes = f->u.pes_filter.opaque;
+        if (pes->stream_type == STREAM_TYPE_VIDEO_H264 && pes->st && !base)
+            base = pes;
+        else if (pes->stream_type == STREAM_TYPE_VIDEO_MVC && !pes->st && !dep)
+            dep = pes;
+    }
+    if (!base || !dep || ts->mvc_pes[0] == base && ts->mvc_pes[1] == dep)
+        return;
+    if (ts->mvc_pes[0])     /* only one pair per transport stream */
+        return;
+
+    for (int i = 0; i < 2; i++)
+        if (!ts->mvc_acc[i] && !(ts->mvc_acc[i] = av_packet_alloc()) ||
+            !ts->mvc_tmp[i] && !(ts->mvc_tmp[i] = av_packet_alloc()))
+            return;
+    ts->mvc_pes[0] = base;
+    ts->mvc_pes[1] = dep;
+    base->mvc_role = MVC_BASE;
+    dep->mvc_role  = MVC_DEP;
+    av_log(ts->stream, AV_LOG_VERBOSE, "H.264 MVC: dependent view PID 0x%x merged into stream #%d (PID 0x%x)\n",
+           dep->pid, base->st->index, base->pid);
+}
+
+/* Offsets of the units (access units, or view components) in an Annex B buffer;
+ * returns their number. */
+static int mvc_split_units(const uint8_t *buf, int size, int dependent,
+                           int starts[MVC_MAX_UNITS])
+{
+    int n = 1, seen_vcl = 0, pending = -1;
+
+    starts[0] = 0;
+    for (int i = 0; i + 3 < size; i++) {
+        int start, type, vcl, first_mb_zero;
+
+        if (buf[i] || buf[i + 1] || buf[i + 2] != 1)
+            continue;
+        start = i > 0 && !buf[i - 1] ? i - 1 : i;
+        i    += 3;
+        type  = buf[i] & 0x1f;
+        vcl   = dependent ? type == H264_NAL_EXTEN_SLICE : type == H264_NAL_SLICE || type == H264_NAL_IDR_SLICE;
+        /* first_mb_in_slice == 0, coded as a single 1 bit */
+        first_mb_zero = i + (dependent ? 4 : 1) < size && buf[i + (dependent ? 4 : 1)] & 0x80;
+
+        if (dependent ? type == H264_NAL_UNSPECIFIED24 : type == H264_NAL_AUD) {
+            if (seen_vcl && n < MVC_MAX_UNITS)
+                starts[n++] = start;
+            seen_vcl = 0;
+            pending  = -1;
+        } else if (vcl) {
+            if (seen_vcl && first_mb_zero && n < MVC_MAX_UNITS)
+                starts[n++] = pending >= 0 ? pending : start;
+            seen_vcl = 1;
+            pending  = -1;
+        } else if (seen_vcl && pending < 0) {
+            pending = start;
+        }
+    }
+    return n;
+}
+
+static int mvc_append_units(uint8_t *dst, const uint8_t *src, int start, int end, int dependent)
+{
+    int len = 0, i = start;
+
+    while (i < end) {
+        int next = end, j;
+        /* find the start code after the one at i */
+        for (j = i + 3; j + 2 < end; j++)
+            if (!src[j] && !src[j + 1] && src[j + 2] == 1) {
+                next = j > i + 3 && !src[j - 1] ? j - 1 : j;
+                break;
+            }
+        {
+            int hdr = i;
+            while (hdr + 2 < next && !(src[hdr] == 0 && src[hdr + 1] == 0 && src[hdr + 2] == 1))
+                hdr++;
+            if (!(dependent && hdr + 3 < next && (src[hdr + 3] & 0x1f) == H264_NAL_UNSPECIFIED24)) {
+                memcpy(dst + len, src + i, next - i);
+                len += next - i;
+            }
+        }
+        i = next;
+    }
+    return len;
+}
+
+static int mvc_merge(MpegTSContext *ts, AVPacket *out, AVPacket *base, AVPacket *dep)
+{
+    int bs[MVC_MAX_UNITS + 1], ds[MVC_MAX_UNITS + 1];
+    int nb = mvc_split_units(base->data, base->size, 0, bs);
+    int nd = mvc_split_units(dep->data,  dep->size,  1, ds);
+    int len = 0, ret;
+
+    ret = av_new_packet(out, base->size + dep->size);
+    if (ret < 0)
+        return ret;
+    ret = av_packet_copy_props(out, base);
+    if (ret < 0)
+        return ret;
+
+    bs[nb] = base->size;
+    ds[nd] = dep->size;
+    if (nb != nd) {
+        if (!ts->mvc_mismatch_warned++)
+            av_log(ts->stream, AV_LOG_WARNING, "H.264 MVC: %d base view access units "
+                   "but %d dependent view components in a PES packet\n", nb, nd);
+        nb = nd = 1;
+        bs[1] = base->size;
+        ds[1] = dep->size;
+    }
+    for (int i = 0; i < nb; i++) {
+        len += mvc_append_units(out->data + len, base->data, bs[i], bs[i + 1], 0);
+        len += mvc_append_units(out->data + len, dep->data,  ds[i], ds[i + 1], 1);
+    }
+    out->size = len;
+    memset(out->data + len, 0, AV_INPUT_BUFFER_PADDING_SIZE);
+    return 0;
+}
+
+static int64_t mvc_packet_time(const AVPacket *pkt)
+{
+    return pkt->dts != AV_NOPTS_VALUE ? pkt->dts : pkt->pts;
+}
+
+/* Emit a packet of the base view stream once one can be formed; returns 1 if pkt
+ * was filled. */
+static int mvc_output(MpegTSContext *ts, AVPacket *pkt, int eof)
+{
+    AVPacket *base = ts->mvc_tmp[0], *dep = ts->mvc_tmp[1];
+    int ret;
+
+    for (;;) {
+        PacketListEntry *b = ts->mvc_queue[0].head, *d = ts->mvc_queue[1].head;
+        int cmp = 0;
+
+        if (b && d) {
+            int64_t bt = mvc_packet_time(&b->pkt), dt = mvc_packet_time(&d->pkt);
+            if (bt != AV_NOPTS_VALUE && dt != AV_NOPTS_VALUE)
+                cmp = av_compare_mod(bt, dt, 1LL << 33);
+        }
+
+        if (d && (b ? cmp > 0 : eof || ts->mvc_queued[1] > MVC_MAX_QUEUED)) {
+            /* a dependent view packet with no base view partner */
+            av_log(ts->stream, AV_LOG_DEBUG, "H.264 MVC: dropping unmatched dependent view packet\n");
+            ff_packet_list_get(&ts->mvc_queue[1], dep);
+            ts->mvc_queued[1]--;
+            av_packet_unref(dep);
+            continue;
+        }
+
+        if (b && d && !cmp) {
+            ff_packet_list_get(&ts->mvc_queue[0], base);
+            ff_packet_list_get(&ts->mvc_queue[1], dep);
+            ts->mvc_queued[0]--;
+            ts->mvc_queued[1]--;
+            av_packet_unref(pkt);
+            ret = mvc_merge(ts, pkt, base, dep);
+            av_packet_unref(base);
+            av_packet_unref(dep);
+            return ret < 0 ? ret : 1;
+        }
+
+        if (b && (d || eof || ts->mvc_queued[0] > MVC_MAX_QUEUED)) {
+            /* a base view packet whose dependent view went missing */
+            av_packet_unref(pkt);
+            ff_packet_list_get(&ts->mvc_queue[0], pkt);
+            ts->mvc_queued[0]--;
+            return 1;
+        }
+        return 0;
+    }
+}
+
+/* Take over the payload of a paired PES packet instead of emitting it. final is set
+ * once the PES packet is complete. Returns 1 if ts->pkt was filled. */
+static int mvc_take_pes(MpegTSContext *ts, PESContext *pes, int final)
+{
+    const int view = pes->mvc_role == MVC_DEP;
+    AVPacket *acc  = ts->mvc_acc[view];
+    uint8_t *sd;
+    int ret;
+
+    if (pes->data_index > 0) {
+        if (!acc->data) {
+            ret = av_new_packet(acc, pes->data_index);
+            if (ret < 0)
+                return ret;
+            memcpy(acc->data, pes->buffer->data, pes->data_index);
+            acc->pts   = pes->pts;
+            acc->dts   = pes->dts;
+            acc->pos   = pes->ts_packet_pos;
+            acc->flags = pes->flags;
+            if (!view)
+                acc->stream_index = pes->st->index;
+        } else {
+            int old = acc->size;
+            ret = av_grow_packet(acc, pes->data_index);
+            if (ret < 0)
+                return ret;
+            memcpy(acc->data + old, pes->buffer->data, pes->data_index);
+            acc->flags |= pes->flags & AV_PKT_FLAG_CORRUPT;
+        }
+    }
+    reset_pes_packet_state(pes);
+
+    if (!final || !acc->data)
+        return 0;
+
+    if (!view) {
+        sd = av_packet_new_side_data(acc, AV_PKT_DATA_MPEGTS_STREAM_ID, 1);
+        if (!sd)
+            return AVERROR(ENOMEM);
+        *sd = pes->stream_id;
+    }
+    ret = ff_packet_list_put(&ts->mvc_queue[view], acc, NULL, 0);
+    if (ret < 0)
+        return ret;
+    ts->mvc_queued[view]++;
+
+    if (!ts->pkt)
+        return 0;
+    return mvc_output(ts, ts->pkt, 0);
+}
